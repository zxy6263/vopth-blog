{
  // ==========================================================================
  //  Cloudflare Workers 配置文件
  // --------------------------------------------------------------------------
  //  为什么需要这个文件？
  //  Cloudflare 新的「导入仓库」流程（Workers Builds）分两步：
  //      1. 构建命令：npm run build        → 生成 public/
  //      2. 部署命令：npx wrangler deploy  → 上传 public/ 并发布
  //  第 2 步靠这个文件知道「产物在哪个目录」。没有它的话，Cloudflare 会尝试
  //  自动识别框架并给你开一个 Pull Request，多绕一圈。
  //
  //  注意：这个文件放在仓库根目录，不在 source/ 里，所以不会被发布到网站上。
  // ==========================================================================

  "name": "vopth-blog",

  // Cloudflare 用它来决定运行时行为。填一个「今天或过去」的日期即可，
  // 以后想启用新的运行时特性时再改。
  "compatibility_date": "2026-10-02",

  "assets": {
    // Hexo 的构建产物目录 —— 这是整个文件里最关键的一行
    "directory": "./public/",

    // 找不到页面时，返回 public/404.html，并带 404 状态码
    "not_found_handling": "404-page",

    // 目录索引（/a/b/index.html）带尾斜杠访问，
    // 单个文件（/404.html）不带尾斜杠访问。
    // 和 Hexo 的 pretty_urls 设置相匹配。
    "html_handling": "auto-trailing-slash"
  }

  // 这里故意不写 "main" —— 没有 Worker 脚本，就是纯静态资源。
  // 好处：静态资源请求不计费、不限量。
  // 以后想加接口（比如自己写评论后端），再加 "main": "./src/index.js"。
}
