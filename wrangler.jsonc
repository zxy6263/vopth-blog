{
  // ==========================================================================
  //  Cloudflare Workers 配置文件
  // --------------------------------------------------------------------------
  //  为什么需要这个文件？
  //  Cloudflare 新的「导入仓库」流程（Workers Builds）分两步：
  //      1. 构建命令：npm run build        → 生成 public/
  //      2. 部署命令：npx wrangler deploy  → 上传 public/ 并发布
  //  第 2 步靠这个文件知道「产物在哪个目录」。没有它的话，Cloudflare 会尝试
  //  自动识别框架并给你开一个 Pull Request，多绕一圈。
  //
  //  注意：这个文件放在仓库根目录，不在 source/ 里，所以不会被发布到网站上。
  // ==========================================================================

  "name": "vopth-blog",

  // Cloudflare 用它来决定运行时行为。填一个「今天或过去」的日期即可，
  // 以后想启用新的运行时特性时再改。
  "compatibility_date": "2026-10-02",

  // --------------------------------------------------------------------------
  //  Worker 脚本（浏览量计数器，见 src/index.js）
  //
  //  之前这里【故意不写 main】，是纯静态资源 —— 因为当时没有任何接口需求。
  //  现在只需要处理 /api/views 一个接口，其余请求原样交给下面的静态资源。
  //
  //  ⚠️ 加了 main 会不会影响「静态资源免费不限量」？不会。
  //     Cloudflare 文档原文（static-assets/billing-and-limitations）：
  //       "Requests to static assets are free and unlimited.
  //        Requests to the Worker script are billed according to Workers pricing."
  //     也就是：请求【命中静态资源】时不跑 Worker、不计费；
  //     只有落到 /api/views 这种没有对应文件的路径上才会调用 Worker。
  //
  //  ⚠️ 前提：不要开启 run_worker_first（这里没开，保持默认 false）。
  //     开了之后匹配到的请求会被强制送进 Worker，免费额度用完后直接 429。
  // --------------------------------------------------------------------------
  "main": "./src/index.js",

  // 浏览量存这里。"PAGEVIEWS" 就是 src/index.js 里的 env.PAGEVIEWS。
  //
  // ⚠️ 这里【故意不写 id】。
  //    wrangler 4.x 支持「自动创建资源」：绑定时不给 id，部署时会自动
  //    创建对应的 KV 命名空间并接上。
  //    实测：
  //      · 省略 id  -> `wrangler deploy --dry-run` 通过，并列出 env.PAGEVIEWS 绑定
  //      · "id": "" -> 被拒（要求是 string "id"）
  //    如果哪次部署报 KV 相关的错，改成显式 id 即可：
  //      npx wrangler kv namespace create PAGEVIEWS
  //    或仪表盘 → 存储和数据库 → KV → 创建命名空间，把 ID 填进 "id"。
  "kv_namespaces": [
    { "binding": "PAGEVIEWS" }
  ],

  // --------------------------------------------------------------------------
  //  网页后台（/admin/）用到的变量
  //
  //  ⚠️ 这里【只放不是秘密的东西】。密钥一律用 `npx wrangler secret put <名字>`：
  //       GITHUB_TOKEN     GitHub 细粒度 PAT，权限只需要 Contents: Read and write
  //
  //  ⚠️ 下面两个要等你先在 Cloudflare 后台把 Access 配好才能拿到，
  //     所以现在没填 —— 没填时后台一律返回 403（fail closed），不会漏。
  //     拿到之后取消注释并填上，然后重新部署：
  //       ACCESS_TEAM_DOMAIN   形如 myteam.cloudflareaccess.com（不带 https://）
  //       ACCESS_AUD           Access 应用的 Audience 标签，在应用详情页能看到
  //
  //  ⚠️ 注意：部署时「配置文件里的 vars」会覆盖控制台里手填的同名变量。
  //     所以要么都写在下面，要么都在控制台填 —— 别一边一半。
  // --------------------------------------------------------------------------
  "vars": {
    "GITHUB_REPO": "zxy6263/vopth-blog",
    "GITHUB_BRANCH": "main",

    // Cloudflare Access（页面和接口都要过它）
    "ACCESS_TEAM_DOMAIN": "lucky-credit-a531.cloudflareaccess.com",
    // ⚠️ 每个 Access 应用有自己的 AUD。站点保护了两个路径
    //    （/admin 和 /api/admin），所以如果建成了【两个应用】，
    //    这里就要写两个 AUD，用逗号隔开。
    "ACCESS_AUD": "8419b4cbc457ea7267faaf6245fd532dfcefca9adeda002aa56e4b60bfbfa9c2"
  },

  // --------------------------------------------------------------------------
  //  定时任务（Cron Trigger）
  //
  //  每 3 小时跑一次 Worker 里的 scheduled()，发一封站点状态报告。
  //  cron 表达式用的是 UTC：0 */3 * * * 即 UTC 的 0/3/6/.../21 点，
  //  对应北京时间 8/11/14/17/20/23 点和次日 2/5 点，正好每 3 小时一次。
  //
  //  ⚠️ 时区不影响"每隔 3 小时"这个事实，但报告里标的时间会写明是哪个时区。
  // --------------------------------------------------------------------------
  "triggers": {
    "crons": ["0 */3 * * *"]
  },

  "assets": {
    // Hexo 的构建产物目录 —— 这是整个文件里最关键的一行
    "directory": "./public/",

    // ⚠️ 必须显式给静态资源起个绑定名，否则 Worker 里的 env.ASSETS 是
    //    undefined —— 表现是「不存在的路径返回 500 而不是 404」。
    //    因为命中了静态文件的请求根本不跑 Worker，只有没命中的才会
    //    落到 Worker 里，那时就需要我们自己把它交还给静态资源层。
    "binding": "ASSETS",

    // 找不到页面时，返回 public/404.html，并带 404 状态码
    "not_found_handling": "404-page",

    // 目录索引（/a/b/index.html）带尾斜杠访问，
    // 单个文件（/404.html）不带尾斜杠访问。
    // 和 Hexo 的 pretty_urls 设置相匹配。
    "html_handling": "auto-trailing-slash"
  }
}
