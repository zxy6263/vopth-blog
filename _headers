# ===========================================================================
#  Cloudflare 响应头配置
#  Docs: https://developers.cloudflare.com/pages/configuration/headers/
#
#  说明：Hexo 不会自动复制以 _ 开头的文件，所以 tools/post-build.js
#  会在构建结束后把本文件复制到 public/ 下。
#
#  ⚠️ 为什么这些 Cache-Control 很重要
#    Cloudflare Workers 静态资源的【默认】缓存头是
#      public, max-age=0, must-revalidate
#    意思是「每次访问、每个资源，都要回源验证一次」。
#    而国内到 Cloudflare 的 RTT 常常 0.6~1.3 秒 —— 于是重复访问也一直慢。
#    下面按「这个文件多久会变」分别给策略。
# ===========================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# ----------------------------------------------------------------- 长缓存
# 图片、字体这类基本不变的内容，缓存一周
/img/*
  Cache-Control: public, max-age=604800

# 第三方库：路径里自带 ?v=版本号，升级会换 URL，所以可以放心长缓存
/pluginsSrc/*
  Cache-Control: public, max-age=2592000

# 视频从不改动 —— 直接一年 immutable
# 这两个文件有 3.2 MB / 5.6 MB，之前 max-age=0 会让每次访问都重新验证一遍
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# ----------------------------------------------------------------- 中缓存
# 站点自己的 CSS / JS：【文件名不带 hash】，改版后 URL 不变，
# 所以不能用一年。用「1 小时 + 后台异步更新」：
# 既省掉绝大部分重复验证，又不会让访客长时间卡在旧版本上。
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# 搜索索引：内容随文章变，但变化不频繁
/search.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# RSS：阅读器会轮询，给半小时 + 后台更新
/atom.xml
  Cache-Control: public, max-age=1800, stale-while-revalidate=86400

# --------------------------------------------------------------- 不缓存
# HTML 永远回源校验，保证一发文章就能看到
/*.html
  Cache-Control: public, max-age=0, must-revalidate
